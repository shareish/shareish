#: mymap/templates/emails/activation.html:4
#, python-format
msgid "%(site_name)s solidarity platform - Please confirm account creation"
msgstr ""
"Plateforme solidaire %(site_name)s - Veuillez confirmer la création de votre "
"compte"

#: mymap/templates/emails/activation.html:8
#, python-format
msgid ""
"Hello, You're receiving this email because an account creation was initiated "
"on %(site_name)s and you need to finish the activation process."
msgstr ""
"Bonjour, Vous recevez cet e-mail car une création de compte a été initiée "
"sur %(site_name)s et vous devez terminer le processus d'activation."

#: mymap/templates/emails/activation.html:10
#: mymap/templates/emails/activation.html:21
msgid "Please go to the following page to confirm and activate your account:"
msgstr ""
"Veuillez vous rendre sur la page suivante pour confirmer et activer votre "
"compte :"

#: mymap/templates/emails/activation.html:13
#: mymap/templates/emails/activation.html:24
msgid "Thanks for using our site!"
msgstr "Merci d'utiliser notre site !"

#: mymap/templates/emails/activation.html:15
#: mymap/templates/emails/activation.html:26
#: mymap/templates/emails/confirmation.html:12
#: mymap/templates/emails/confirmation.html:20
#, python-format
msgid "The %(site_name)s team"
msgstr "L'équipe %(site_name)s"

#: mymap/templates/emails/activation.html:19
#, python-format
msgid ""
"Hello,<br><br> You're receiving this email because an account creation was "
"initiated on %(site_name)s and you need to finish the activation process."
msgstr ""
"Bonjour,<br><br> Vous recevez cet e-mail car une création de compte a été "
"initiée sur %(site_name)s et vous devez terminer le processus d'activation."

#: mymap/templates/emails/confirmation.html:4
#, python-format
msgid ""
"%(site_name)s solidarity platform - Your account has been successfully "
"activated!"
msgstr ""
"Plateforme solidaire %(site_name)s - Votre compte a été activé avec succès !"

#: mymap/templates/emails/confirmation.html:8
#, python-format
msgid ""
"Hello, Your %(site_name)s account has been created and is ready to use, "
"please log in on: %(protocol)s://%(domain)s/log-in ! We invite you to edit "
"your profile and settings here: %(protocol)s://%(domain)s/settings/"
"notification to configure notifications when new content is created in your "
"neighbourdhood. You can also provide more details about yourself here: "
"%(protocol)s://%(domain)s/settings/profile ."
msgstr ""
"Bonjour, Votre compte %(site_name)s a été créé et est prêt à être utilisé, "
"veuillez vous connecter sur : %(protocol)s://%(domain)s/log-in ! Nous vous "
"invitons à modifier votre profil et vos paramètres ici : %(protocol)s://"
"%(domain)s/settings/notification pour configurer les notifications lorsque "
"du nouveau contenu est créé dans votre quartier. Vous pouvez également "
"fournir plus de détails sur vous ici : %(protocol)s://%(domain)s/settings/"
"profile ."

#: mymap/templates/emails/confirmation.html:10
#: mymap/templates/emails/confirmation.html:18
msgid "Thanks for using Share & Cherish!"
msgstr "Merci d'utiliser Share & Cherish !"

#: mymap/templates/emails/confirmation.html:16
#, python-format
msgid ""
"Hello,<br><br>Your %(site_name)s account has been created and is ready to "
"use, please log in at: <a href=\"%(protocol)s://%(domain)s/log-in\">"
"%(protocol)s://%(domain)s/log-in</a> ! <br><br>Then, we invite you to "
"<b>edit your profile and settings</b> (top-right \"Account\" menu) here: <a "
"href=\"%(protocol)s://%(domain)s/settings/notifications\">%(protocol)s://"
"%(domain)s/settings/notifications</a> to <b>configure notifications</b> when "
"new content is created in your neighbourdhood. You can also provide more "
"details about yourself here: <a href=\"%(protocol)s://%(domain)s/settings/"
"profile\">%(protocol)s://%(domain)s/settings/profile</a>. "
msgstr ""
"Bonjour,<br><br>Votre compte %(site_name)s a été créé et est prêt à être "
"utilisé, veuillez vous connecter à l'adresse suivante : <a href="
"\"%(protocol)s://%(domain)s/log-in\">%(protocol)s://%(domain)s/log-in</a> ! "
"<br><br>Ensuite, nous vous invitons à <b>modifier votre profil et vos "
"paramètres</b> (menu \"Compte\" en haut à droite) ici : <a href="
"\"%(protocol)s://%(domain)s/settings/notifications\">%(protocol)s://"
"%(domain)s/settings/notifications</a> pour <b>configurer les notifications</"
"b> lorsque de nouveaux contenus sont créés dans votre voisinage. Vous pouvez "
"également fournir plus de détails sur vous ici : <a href=\"%(protocol)s://"
"%(domain)s/settings/profile\">%(protocol)s://%(domain)s/settings/profile</"
"a>. "

